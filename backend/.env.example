ENVIRONMENT=development
DEBUG=true

# Development SQLite:
DATABASE_URL=sqlite:///./certichain.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://certichain:CHANGE_ME@db:5432/certichain

# Generate a random value of at least 32 characters.
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Set true only after the smart contract and wallet are configured.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
ISSUER_PRIVATE_KEY=
BLOCKCHAIN_CHAIN_ID=

# Keep false in production. Create issuers through an admin workflow.
ALLOW_PUBLIC_ISSUER_REGISTRATION=false
