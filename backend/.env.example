ENVIRONMENT=development

DEBUG=true


DATABASE_URL=sqlite:///./certichain.db


JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_123456789

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30


CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501


MAX_UPLOAD_SIZE=10485760

UPLOAD_DIR=./uploads


# ============================================================
# ETHEREUM SEPOLIA
# ============================================================

BLOCKCHAIN_ENABLED=true


# Replace YOUR_ALCHEMY_API_KEY
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY


# Replace with the address Remix gives you after deployment
BLOCKCHAIN_CONTRACT_ADDRESS=PASTE_YOUR_DEPLOYED_CONTRACT_ADDRESS


# Ethereum Sepolia
BLOCKCHAIN_CHAIN_ID=11155111


# DO NOT PUT YOUR METAMASK PRIVATE KEY HERE
ISSUER_PRIVATE_KEY=


ALLOW_PUBLIC_ISSUER_REGISTRATION=false